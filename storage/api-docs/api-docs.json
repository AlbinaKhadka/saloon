                                        "type": "string",
                                        "format": "binary",
                                        "nullable": true
                                    },
                                    "status": {
                                        "description": "0 = inactive, 1 = active",
                                        "type": "integer",
                                        "enum": [
                                            0,
                                            1
                                        ]
                                    },
                                    "orderby": {
                                        "type": "integer",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
